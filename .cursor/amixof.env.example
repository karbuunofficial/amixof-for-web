# Copy to .cursor/amixof.env and fill in. That file is git-ignored; never commit it.

# SSH target for the production server (user@host or an alias from ~/.ssh/config).
# Key-based auth only: the scripts run ssh with BatchMode=yes and will not prompt for a password.
AMIXOF_SSH=root@your-server

# Public site the checks run against.
AMIXOF_URL=https://www.amixof.com

# Server layout (defaults match the current deployment).
AMIXOF_COMPOSE_DIR=/opt/stoat
AMIXOF_SERVICE=web

# Public repo the server builds from (must contain the commit being deployed).
AMIXOF_REPO=https://github.com/karbuunofficial/amixof-for-web.git
AMIXOF_GIT_REMOTE=amixof

# Optional: a markdown runbook file (in another repo) that deploy.sh appends a record to.
# AMIXOF_RUNBOOK_FILE=/Volumes/VideoScratch/xipspace/self-hosted-main/RUNBOOK.md

# Optional: a dedicated test account for signed-in checks. Never use a real person's account.
# AMIXOF_TEST_EMAIL=
# AMIXOF_TEST_PASSWORD=
